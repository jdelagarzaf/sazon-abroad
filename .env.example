# Copiar las variables necesarias a .env SIN sobrescribir un .env existente.
# app.py carga .env; las variables de la terminal tienen prioridad.
SAZON_OLLAMA_URL=http://127.0.0.1:11434
SAZON_OLLAMA_MODEL=gemma3:4b
SAZON_OLLAMA_TIMEOUT=120
SAZON_OLLAMA_CONTEXT=4096
SAZON_OLLAMA_OUTPUT_TOKENS=1200

# Gratuito sin tarjeta: instrucciones en docs/comercios.md.
TAVILY_API_KEY=PEGA_TU_CLAVE_AQUI
SAZON_SEARCH_DAILY_LIMIT=25
# Opcional al desplegar: secreto aleatorio persistente; localmente se crea en .runtime/.
# SAZON_SESSION_SECRET=
